{% extends "base.html.j2" %}
{% block styles %}
:root {
  --accent: #5b3cc4;
  --accent-2: #0ea5a4;
  --font: "Inter", "Segoe UI", system-ui, -apple-system, Roboto, sans-serif;
  --surface: #f4f3fb;
  --border: #e3e0f0;
  --radius: 10px;
  --code-bg: #1b1730;
  --code-text: #e9e6ff;
}
.cover { background: linear-gradient(135deg, var(--accent) 0%, #2a1a6e 55%, var(--accent-2) 130%); color: #fff; }
.is-html .cover { border-radius: 16px; margin-top: 16px; padding: 40px 0; }
.cover h1 { font-size: 3em; font-weight: 800; letter-spacing: -.02em; }
.cover .subtitle, .cover-meta dt { color: rgba(255,255,255,.75); }
.cover .classification { color: #fff; border-color: rgba(255,255,255,.7); }
.cover .logo { background: #fff; padding: 10px 14px; border-radius: 10px; }
h2 { font-weight: 800; letter-spacing: -.01em; }
.section > h2, .toc > h2 { display: flex; align-items: center; gap: 10px; }
.section > h2::before, .toc > h2::before { content: ""; width: 6px; height: 1em; border-radius: 3px; background: linear-gradient(var(--accent), var(--accent-2)); }
.finding { background: var(--bg); border: 1px solid var(--border); border-left: 6px solid var(--sev-information); border-radius: var(--radius); padding: 18px 22px; box-shadow: 0 1px 3px rgba(30,20,80,.06); }
.finding.sev-high { border-left-color: var(--sev-high); }
.finding.sev-medium { border-left-color: var(--sev-medium); }
.finding.sev-low { border-left-color: var(--sev-low); }
.finding.sev-false-positive { border-left-color: var(--sev-false-positive); }
.finding .fid { color: var(--accent); }
.tile { border-radius: 12px; }
pre.http { border-color: transparent; }
.doc-header h1 { background: linear-gradient(90deg, var(--accent), var(--accent-2)); -webkit-background-clip: text; background-clip: text; color: transparent; }

/* side navigation (HTML only) */
.sidebar { position: fixed; top: 0; left: 0; bottom: 0; width: 260px; overflow-y: auto; padding: 20px 16px; border-right: 1px solid var(--border); background: var(--surface); font-size: .86em; }
.sidebar strong { display: block; margin-bottom: 10px; color: var(--accent); }
.sidebar a { display: flex; gap: 8px; align-items: baseline; padding: 4px 6px; border-radius: 6px; color: var(--text); text-decoration: none; }
.sidebar a:hover { background: var(--bg); }
.sidebar .dot { width: 8px; height: 8px; border-radius: 50%; flex: none; background: var(--sev-information); }
.sidebar .dot.sev-high { background: var(--sev-high); }
.sidebar .dot.sev-medium { background: var(--sev-medium); }
.sidebar .dot.sev-low { background: var(--sev-low); }
.sidebar .dot.sev-false-positive { background: var(--sev-false-positive); }
.sidebar hr { border: 0; border-top: 1px solid var(--border); margin: 10px 0; }
@media (min-width: 1100px) { .has-sidebar .doc, .has-sidebar .toolbar { margin-left: 260px; } }
@media (max-width: 1099px) { .sidebar { display: none; } }
{% endblock %}

{% block sidebar %}
{% if not is_pdf and sections.findings and findings %}
<nav class="sidebar" aria-label="Report navigation">
  <strong>{{ meta.title }}</strong>
  {% if sections.executive_summary %}<a href="#executive-summary">Executive summary</a>{% endif %}
  {% if sections.risk_chart or sections.findings_table %}<a href="#overview">Findings overview</a>{% endif %}
  {% if sections.hosts_table %}<a href="#hosts">Affected hosts</a>{% endif %}
  <hr>
  {% for f in findings %}
  <a href="#{{ f.anchor }}"><span class="dot {{ f.severity|sev_class }}"></span><span>{{ f.name }}</span></a>
  {% endfor %}
</nav>
<script>document.body.classList.add('has-sidebar');</script>
{% endif %}
{% endblock %}
